---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelineList from '../../components/TimelineList.astro';
import { SITE_TITLE } from '../../consts';
import { getTaxonomyTimelineItems, groupTimelineItemsByTag, type TimelineItem } from '../../lib/timeline';

type Props = {
	posts: TimelineItem[];
};

export async function getStaticPaths() {
	const tagGroups = groupTimelineItemsByTag(await getTaxonomyTimelineItems());

	return [...tagGroups.entries()].map(([tag, posts]) => ({
		params: { tag },
		props: { posts },
	}));
}

const tag = Astro.params.tag!;
const { posts } = Astro.props as Props;
---

<BaseLayout title={`标签：#${tag} - ${SITE_TITLE}`} description={`带有标签 #${tag} 的文章`}>
	<div class="blog-header">
		<div>
			<a href="/tags" class="back-link">&larr; 查看全部标签</a>
			<h1 class="page-title">标签：<span>#{tag}</span></h1>
			<p class="post-count">共 {posts.length} 篇文章</p>
		</div>
	</div>

	<TimelineList items={posts} />
</BaseLayout>

<style>
	.blog-header {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 2.5rem;
		text-align: center;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text-light);
		font-weight: 500;
	}

	.back-link:hover {
		color: var(--color-primary);
	}

	.page-title {
		font-size: 2.2em;
		margin: 0;
		color: var(--color-primary);
	}

	.page-title span {
		color: var(--color-primary);
	}

	.post-count {
		color: var(--color-text-light);
		margin: 0.5rem 0 0;
	}
</style>
