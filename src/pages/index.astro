---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// --- Logic to merge blog and collections ---
const blogPosts = await getCollection('blog');
const collectionMetas = await getCollection('collectionMeta');
const allCollectedPosts = await getCollection('collectedPosts');

let displayItems = blogPosts.map(post => ({
	type: 'blog',
	data: post.data,
	slug: post.id,
	date: post.data.createdAt,
	url: `/blog/${post.id}/`
}));

for (const meta of collectionMetas) {
	const folderName = meta.id.split('/')[0];
	const relatedPosts = allCollectedPosts.filter(p => p.id.startsWith(folderName + '/'));
	
	if (meta.data.isCollapsed) {
		// Get latest date from its posts
		const latestDate = new Date(Math.max(...relatedPosts.map(p => (p.data.updatedAt || p.data.createdAt).getTime())));
		displayItems.push({
			type: 'collection',
			data: {
				...meta.data,
				createdAt: latestDate, // Use latest date for display
				toc: meta.data.toc || false,
			},
			slug: folderName,
			date: latestDate,
			url: `/collections/${folderName}/`
		});
	} else {
		// Add individual posts
		relatedPosts.forEach(post => {
			const postFileName = post.id.split('/').pop();
			displayItems.push({
				type: 'collected-post',
				data: post.data,
				slug: `${folderName}/${postFileName}`,
				date: post.data.createdAt,
				url: `/collections/${folderName}/${postFileName}`
			});
		});
	}
}

const posts = displayItems
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 6);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-content">
			<h1 lang="ja">ようこそ、RotCool の世界へ</h1>
			<p class="hero-sub">想要跟你讲述我的一切！欢迎找我聊天！</p>
			<div class="hero-badges">
				<span class="badge">😴 摆烂</span>
				<span class="badge">📝 学习</span>
				<span class="badge">🍵 日常</span>
			</div>
		</div>
	</section>

	<section class="posts-section">
		<div class="section-header">
			<h2 class="section-title">最新文章</h2>
			<a href="/blog" class="view-all-link-top">
				<span>查看全部</span>
				<span class="arrow-icon">&rarr;</span>
			</a>
		</div>
		<div class="posts-grid">
			{posts.map((post, i) => (
				<div class="post-wrapper" style={`animation: fadeInUp 0.6s ease both ${i * 0.1}s`}>
					<BlogCard
						title={post.data.title}
						description={post.data.description}
						createdAt={post.data.createdAt}
						cover={post.data.cover}
						slug={post.slug}
						tags={post.data.tags}
						category={post.data.category}
						isCollection={post.type === 'collection'}
						customUrl={post.url}
					/>
				</div>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding: 4rem 1rem;
		margin-bottom: 2rem;
		text-align: center;
		overflow: hidden;
		background: var(--color-primary-pale);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
	}

	.hero::before {
		content: '';
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle, var(--color-accent) 0%, transparent 60%);
		opacity: 0.1;
		animation: spin 20s linear infinite;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		animation: fadeInUp 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	.hero h1 {
		font-size: 3em;
		margin-bottom: 0.5rem;
		letter-spacing: -1px;
		color: var(--color-primary);
	}

	.hero-sub {
		color: var(--color-text-light);
		font-size: 1.2em;
		margin: 0 0 1.5rem;
		font-weight: 500;
	}

	.hero-badges {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.badge {
		padding: 0.3rem 0.8rem;
		background: white;
		border-radius: 20px;
		font-size: 0.85em;
		font-weight: 600;
		color: var(--color-primary);
		box-shadow: 0 2px 8px rgba(0,0,0,0.05);
		border: 1px solid var(--color-border);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center; /* 关键：从 flex-end 改为 center 确保两端垂直轴中心对齐 */
		margin-bottom: 1.5rem;
		padding: 0 0.5rem;
	}

	.section-title {
		font-size: 1.6em;
		margin: 0;
		font-weight: 800;
		color: var(--color-text);
		position: relative;
	}

	.section-title::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 40px;
		height: 4px;
		background: var(--color-primary);
		border-radius: 2px;
	}

	.posts-grid {
		column-count: 3;
		column-gap: 1.5rem;
		width: 100%;
	}

	.post-wrapper {
		break-inside: avoid;
		margin-bottom: 1.5rem;
		display: block;
	}

	@media (max-width: 1100px) {
		.posts-grid {
			column-count: 2;
		}
	}

	@media (max-width: 768px) {
		.posts-grid {
			column-count: 1;
		}
	}

	.view-all-link-top {
		font-size: 0.95em;
		font-weight: 600;
		color: var(--color-primary);
		transition: all 0.2s;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		/* 移除强制的 line-height: 1，因为它会切断字体默认的上下安全区导致居中失效 */
		padding: 0.2rem 0;
	}

	.arrow-icon {
		/* 通过相对定位或微小内边距人工抵消大多数中文字体基线偏低导致箭头看起来偏高的问题 */
		transform: translateY(1px);
		font-family: sans-serif; /* 强制使用无衬线字体提高箭头渲染稳定性 */
	}

	.view-all-link-top:hover {
		transform: translateX(4px);
		color: var(--color-primary-light);
	}

	@media (max-width: 768px) {
		.hero {
			padding: 3rem 1rem;
		}
		
		.hero h1 {
			font-size: 2.2em;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}

		.section-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
	}
</style>