---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`About - ${SITE_TITLE}`} description="About me">
	<article class="about-page">
		<h1>About Me</h1>
		<div class="prose">
			<p>
				Hi there! I'm a developer who loves building things for the web.
				When I'm not coding, you can find me watching anime or exploring new technologies.
			</p>
			<p>
				This blog is built with <a href="https://astro.build/">Astro</a> and Vue,
				featuring a cute anime-inspired design. I write about coding, tech, and
				whatever else catches my interest.
			</p>
			<p>
				Feel free to browse around, read some posts, and check out the interactive
				demos in the App section!
			</p>
		</div>
	</article>
</BaseLayout>

<style>
	.about-page {
		max-width: 660px;
	}

	.about-page h1 {
		margin-bottom: 1.5rem;
	}
</style>
