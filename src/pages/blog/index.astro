---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

// --- Logic to merge blog and collections ---
const blogPosts = await getCollection('blog');
const collectionMetas = await getCollection('collectionMeta');
const allCollectedPosts = await getCollection('collectedPosts');

let displayItems = blogPosts.map(post => ({
	type: 'blog',
	data: post.data,
	slug: post.id,
	date: post.data.createdAt,
	url: `/blog/${post.id}/`
}));

for (const meta of collectionMetas) {
	const folderName = meta.id.split('/')[0];
	const relatedPosts = allCollectedPosts.filter(p => p.id.startsWith(folderName + '/'));
	
	if (meta.data.isCollapsed) {
		const latestDate = new Date(Math.max(...relatedPosts.map(p => (p.data.updatedAt || p.data.createdAt).getTime())));
		displayItems.push({
			type: 'collection',
			data: { ...meta.data, createdAt: latestDate, toc: meta.data.toc || false },
			slug: folderName,
			date: latestDate,
			url: `/collections/${folderName}/`
		});
	} else {
		relatedPosts.forEach(post => {
			const postFileName = post.id.split('/').pop();
			displayItems.push({
				type: 'collected-post',
				data: post.data,
				slug: `${folderName}/${postFileName}`,
				date: post.data.createdAt,
				url: `/collections/${folderName}/${postFileName}`
			});
		});
	}
}

const posts = displayItems.sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Group posts by year
const groupedPosts = posts.reduce((acc, post) => {
	const year = post.date.getFullYear();
	if (!acc[year]) acc[year] = [];
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title={`文章归档 - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<div class="blog-header">
		<h1 class="page-title">文章时间轴</h1>
		<div class="filter-links">
			<a href="/tags" class="filter-btn">🏷️ 标签云</a>
			<a href="/categories" class="filter-btn">📂 全部分类</a>
		</div>
	</div>

	<div class="timeline">
		{years.map((year) => (
			<div class="timeline-group">
				<div class="year-marker">{year} 年</div>
				{groupedPosts[Number(year)].map((post, i) => (
					<div class="timeline-item" style={`animation: fadeInUp 0.5s ease both ${i * 0.1}s`}>
						<div class="timeline-dot"></div>
						<div class="timeline-content">
							<div class="meta">
								<FormattedDate date={post.date} />
								{post.data.category && (
									<a href={`/categories/${post.data.category}`} class="category-link">
										{post.data.category}
									</a>
								)}
								{post.type === 'collection' && <span class="collection-tag">合集</span>}
							</div>
							<a href={post.url} class="title-link">
								<h3 class="title">{post.data.title}</h3>
							</a>
							<p class="description">{post.data.description}</p>
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="tags">
									{post.data.tags.map(tag => (
										<a href={`/tags/${tag}`} class="tag-link">#{tag}</a>
									))}
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		))}
	</div>
</BaseLayout>

<style>
	.blog-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2.5rem;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.page-title {
		font-size: 2.2em;
		margin: 0;
		color: var(--color-primary);
	}

	.year-marker {
		font-size: 1.8em;
		font-weight: 800;
		color: var(--color-primary);
		margin: 2rem 0 1.5rem -2rem;
		padding-left: 0.5rem;
		position: relative;
		z-index: 2;
		background: var(--color-bg-card);
		display: inline-flex;
		align-items: center;
		border-radius: 8px;
		padding: 0.2rem 1rem;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-soft);
	}

	.timeline-group {
		margin-bottom: 2rem;
	}

	.filter-links {
		display: flex;
		gap: 1rem;
	}

	.filter-btn {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		padding: 0.5rem 1rem;
		border-radius: 20px;
		color: var(--color-text);
		font-weight: 600;
		font-size: 0.9em;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		background: var(--color-primary-pale);
		color: var(--color-primary);
		border-color: var(--color-primary-light);
	}

	/* Timeline styles */
	.timeline {
		position: relative;
		padding-left: 2rem;
		margin-top: 1rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 7px; 
		top: 0;
		bottom: 0;
		width: 2px;
		background: linear-gradient(to bottom, var(--color-primary-light), var(--color-primary-pale) 80%, transparent);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 2.5rem;
	}

	.timeline-dot {
		position: absolute;
		left: -2rem;
		top: 0.4rem;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--color-bg-card);
		border: 4px solid var(--color-primary);
		box-shadow: 0 0 0 4px var(--color-bg-card);
		z-index: 1;
		transition: transform 0.3s, background-color 0.3s;
	}

	.timeline-item:hover .timeline-dot {
		transform: scale(1.2);
		background: var(--color-primary);
	}

	.timeline-content {
		background: var(--color-bg);
		padding: 1.5rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		transition: transform 0.3s, box-shadow 0.3s;
	}

	.timeline-item:hover .timeline-content {
		transform: translateX(5px);
		box-shadow: var(--shadow-soft);
		border-color: var(--color-primary-light);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.9em;
		color: var(--color-text-light);
		margin-bottom: 0.5rem;
	}

	.category-link {
		background: var(--color-accent);
		color: white;
		padding: 0 0.6rem;
		height: 20px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
		font-weight: 700;
		font-size: 0.75em;
	}

	.collection-tag {
		background: var(--color-primary);
		color: white;
		padding: 0 0.5rem;
		height: 18px;
		display: inline-flex;
		align-items: center;
		border-radius: 4px;
		font-size: 0.65em;
		font-weight: 800;
	}

	.title-link {
		color: var(--color-text);
		display: inline-block;
	}

	.title {
		margin: 0 0 0.5rem 0;
		font-size: 1.4em;
		transition: color 0.2s;
	}

	.title-link:hover .title {
		color: var(--color-primary);
	}

	.description {
		margin: 0 0 1rem 0;
		color: var(--color-text-light);
		line-height: 1.6;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag-link {
		color: var(--color-primary);
		background: var(--color-primary-pale);
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		font-size: 0.85em;
		transition: background 0.2s;
	}

	.tag-link:hover {
		background: var(--color-primary-light);
		color: var(--color-bg-card);
	}

	@media (max-width: 768px) {
		.timeline {
			padding-left: 1.5rem;
		}
		.timeline::before {
			left: 3px;
		}
		.timeline-dot {
			left: -1.5rem;
			width: 14px;
			height: 14px;
		}
		.year-marker {
			margin-left: -1.5rem;
			font-size: 1.5em;
		}
	}
</style>