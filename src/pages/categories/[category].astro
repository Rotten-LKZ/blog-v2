---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelineList from '../../components/TimelineList.astro';
import { SITE_TITLE } from '../../consts';
import { getTaxonomyTimelineItems, groupTimelineItemsByCategory, type TimelineItem } from '../../lib/timeline';

type Props = {
	posts: TimelineItem[];
};

export async function getStaticPaths() {
	const categoryGroups = groupTimelineItemsByCategory(await getTaxonomyTimelineItems());

	return [...categoryGroups.entries()].map(([category, posts]) => ({
		params: { category },
		props: { posts },
	}));
}

const category = Astro.params.category!;
const { posts } = Astro.props as Props;
---

<BaseLayout title={`分类：${category} - ${SITE_TITLE}`} description={`属于分类 ${category} 的文章`}>
	<div class="blog-header">
		<div>
			<a href="/categories" class="back-link">&larr; 查看全部分类</a>
			<h1 class="page-title">分类：<span>{category}</span></h1>
			<p class="post-count">共 {posts.length} 篇文章</p>
		</div>
	</div>

	<TimelineList items={posts} />
</BaseLayout>

<style>
	.blog-header {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 2.5rem;
		text-align: center;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text-light);
		font-weight: 500;
	}

	.back-link:hover {
		color: var(--color-primary);
	}

	.page-title {
		font-size: 2.2em;
		margin: 0;
		color: var(--color-primary);
	}

	.page-title span {
		color: var(--color-accent);
	}

	.post-count {
		color: var(--color-text-light);
		margin: 0.5rem 0 0;
	}
</style>
