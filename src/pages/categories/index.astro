---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const allPosts = await getCollection('blog');
const categories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];
---

<BaseLayout title={`全部分类 - ${SITE_TITLE}`} description="博客的所有文章分类">
	<div class="page-header">
		<h1 class="page-title">全部分类</h1>
	</div>

	<div class="category-list">
		{categories.map((category) => (
			<a href={`/categories/${category}`} class="category-item">
				<span class="folder-icon">📂</span>
				<span class="category-name">{category}</span>
			</a>
		))}
	</div>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 2rem;
		text-align: center;
	}
	.page-title {
		font-size: 2.5em;
		margin: 0;
		color: var(--color-primary);
	}
	.category-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1rem;
	}
	.category-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1.5rem;
		background: var(--color-bg-card);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-soft);
		transition: all 0.3s;
		color: var(--color-text);
		text-decoration: none;
	}
	.category-item:hover {
		transform: translateY(-4px);
		border-color: var(--color-primary-light);
		box-shadow: var(--shadow-hover);
		color: var(--color-primary);
	}
	.folder-icon {
		font-size: 1.5em;
	}
	.category-name {
		font-weight: 700;
		font-size: 1.1em;
	}
</style>