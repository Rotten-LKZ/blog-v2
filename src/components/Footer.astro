---
import UpyunLogo from '../assets/upyun.svg';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} RotCool. All rights reserved.</p>
	<p class="cdn-link">本网站由<a href="https://www.upyun.com/?utm_source=lianmeng&utm_medium=referral" target="_blank"> <UpyunLogo /> </a>提供CDN加速/云存储服务</p>
</footer>

<style>
	footer {
		padding: 1rem 1rem;
		text-align: center;
		color: var(--color-text-light);
		font-size: 0.85em;
		border-top: 1px solid var(--color-border);
	}

	footer p {
		margin: 0;
		line-height: 1.3;
	}

	footer p + p {
		margin-top: -0.1em;
	}

	.cdn-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.25em;
		line-height: 1;
	}

	.cdn-link :global(svg) {
		height: 1em;
		width: auto;
		vertical-align: middle;
		transform: translateY(-2px);
	}
</style>
