---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import TagPill from './TagPill.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	createdAt: Date;
	cover?: ImageMetadata;
	slug: string;
	tags?: string[];
	category?: string;
	isCollection?: boolean;
	customUrl?: string;
}

const { title, description, createdAt, cover, slug, tags = [], category, isCollection, customUrl } = Astro.props;
---

<a href={customUrl || `/blog/${slug}/`} class:list={["blog-card", { 'collection-card': isCollection }]}>
	{cover && (
		<div class="card-image">
			<Image src={cover} alt={title} width={600} height={300} />
		</div>
	)}
	<div class="card-body">
		<h3 class="card-title">{title}</h3>
		<p class="card-desc">{description}</p>
		<div class="card-meta">
			<div class="meta-left">
				<FormattedDate date={createdAt} />
				{isCollection && <span class="collection-indicator-text">系列合集</span>}
			</div>
			<div class="card-tags">
				{category && <span class="category-badge">{category}</span>}
				{tags.slice(0, 2).map((tag) => <TagPill tag={tag} />)}
			</div>
		</div>
	</div>
</a>

<style>
	.blog-card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg-card);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
		text-decoration: none;
		color: inherit;
		animation: fadeInUp 0.6s ease both;
		border: 1px solid var(--color-border);
		position: relative;
	}

	.blog-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-hover);
		border-color: var(--color-primary-light);
	}

	.collection-card {
		border: 2px solid var(--color-primary-light);
	}

	.meta-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.collection-indicator-text {
		color: var(--color-primary);
		font-size: 0.75em;
		font-weight: 800;
		background: var(--color-primary-pale);
		padding: 0 0.5rem;
		height: 24px; /* Matches category-badge height */
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		line-height: 1;
	}

	.card-image {
		overflow: hidden;
		position: relative;
	}

	.card-image::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 40px;
		background: linear-gradient(to top, var(--color-bg-card), transparent);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.blog-card:hover .card-image::after {
		opacity: 1;
	}

	.card-image :global(img) {
		width: 100%;
		height: auto;
		display: block;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	.blog-card:hover .card-image :global(img) {
		transform: scale(1.1);
	}

	.card-body {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.75rem;
	}

	.card-title {
		font-size: 1.25em;
		margin: 0;
		color: var(--color-text);
		line-height: 1.3;
		font-weight: 700;
		transition: color 0.3s ease;
	}

	.blog-card:hover .card-title {
		color: var(--color-primary);
	}

	.card-desc {
		color: var(--color-text-light);
		font-size: 0.9em;
		margin: 0;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-meta {
		margin-top: auto;
		padding-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-top: 1px dashed var(--color-border);
	}

	.card-tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		align-items: center;
	}

	.category-badge {
		background: var(--color-accent);
		color: white;
		padding: 0 0.6rem;
		height: 24px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
		font-size: 0.75em;
		font-weight: 700;
		line-height: 1;
	}
</style>