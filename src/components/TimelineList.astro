---
import FormattedDate from './FormattedDate.astro';
import { categoryUrl, groupTimelineItemsByYear, tagUrl, type TimelineItem } from '../lib/timeline';

interface Props {
	items: TimelineItem[];
}

const { items } = Astro.props;
const yearGroups = groupTimelineItemsByYear(items);
---

<div class="timeline">
	{yearGroups.map((group) => (
		<div class="timeline-group">
			<div class="year-marker">{group.year} 年</div>
			{group.items.map((item, i) => (
				<div class="timeline-item" style={`animation: fadeInUp 0.5s ease both ${i * 0.1}s`}>
					<div class="timeline-dot"></div>
					<div class="timeline-content">
						<div class="meta">
							<FormattedDate date={item.date} />
							{item.category && (
								<a href={categoryUrl(item.category)} class="category-link">
									{item.category}
								</a>
							)}
							{item.source === 'collection' && <span class="collection-tag">系列合集</span>}
							{item.source === 'collection-post' && <span class="collection-tag">系列文章</span>}
						</div>
						<a href={item.url} class="title-link">
							<h3 class="title">{item.title}</h3>
						</a>
						<p class="description">{item.description}</p>
						{item.tags.length > 0 && (
							<div class="tags">
								{item.tags.map((tag) => (
									<a href={tagUrl(tag)} class="tag-link">#{tag}</a>
								))}
							</div>
						)}
					</div>
				</div>
			))}
		</div>
	))}
</div>

<style>
	.year-marker {
		font-size: 1.8em;
		font-weight: 800;
		color: var(--color-primary);
		margin: 2rem 0 1.5rem -2rem;
		position: relative;
		z-index: 2;
		background: var(--color-bg-card);
		display: inline-flex;
		align-items: center;
		border-radius: 8px;
		padding: 0.2rem 1rem;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-soft);
	}

	.timeline-group {
		margin-bottom: 2rem;
	}

	.timeline {
		position: relative;
		padding-left: 2rem;
		margin-top: 1rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 7px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: linear-gradient(to bottom, var(--color-primary-light), var(--color-primary-pale) 80%, transparent);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 2.5rem;
	}

	.timeline-dot {
		position: absolute;
		left: -2rem;
		top: 0.4rem;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--color-bg-card);
		border: 4px solid var(--color-primary);
		box-shadow: 0 0 0 4px var(--color-bg-card);
		z-index: 1;
		transition: transform 0.3s, background-color 0.3s;
	}

	.timeline-item:hover .timeline-dot {
		transform: scale(1.2);
		background: var(--color-primary);
	}

	.timeline-content {
		background: var(--color-bg);
		padding: 1.5rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		transition: transform 0.3s, box-shadow 0.3s;
	}

	.timeline-item:hover .timeline-content {
		transform: translateX(5px);
		box-shadow: var(--shadow-soft);
		border-color: var(--color-primary-light);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.9em;
		color: var(--color-text-light);
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}

	.category-link {
		background: var(--color-accent);
		color: white;
		padding: 0 0.8rem;
		height: 26px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 13px;
		font-weight: 700;
		font-size: 0.8em;
		line-height: 1;
		padding-top: 1px;
	}

	.collection-tag {
		background: var(--color-primary);
		color: white;
		padding: 0 0.6rem;
		height: 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 4px;
		font-size: 0.75em;
		font-weight: 800;
		line-height: 1;
		padding-top: 1px;
	}

	.title-link {
		color: var(--color-text);
		display: inline-block;
	}

	.title {
		margin: 0 0 0.5rem 0;
		font-size: 1.4em;
		transition: color 0.2s;
	}

	.title-link:hover .title {
		color: var(--color-primary);
	}

	.description {
		margin: 0 0 1rem 0;
		color: var(--color-text-light);
		line-height: 1.6;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag-link {
		color: var(--color-primary);
		background: var(--color-primary-pale);
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		font-size: 0.85em;
		transition: background 0.2s;
	}

	.tag-link:hover {
		background: var(--color-primary-light);
		color: var(--color-bg-card);
	}

	@media (max-width: 768px) {
		.timeline {
			padding-left: 1.5rem;
		}
		.timeline::before {
			left: 3px;
		}
		.timeline-dot {
			left: -1.5rem;
			width: 14px;
			height: 14px;
		}
		.year-marker {
			margin-left: -1.5rem;
			font-size: 1.5em;
		}
	}
</style>
