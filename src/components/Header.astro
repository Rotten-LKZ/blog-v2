---
// Header is now minimal — navigation has moved to Sidebar and MobileNav.
// This component is kept for potential use in layouts that don't use BaseLayout.
import { SITE_TITLE } from '../consts';
---

<header>
	<a href="/" class="site-title">{SITE_TITLE}</a>
</header>

<style>
	header {
		padding: 1rem 1.5rem;
		background: var(--color-bg-card);
		border-bottom: 1px solid var(--color-border);
	}

	.site-title {
		font-weight: 700;
		font-size: 1.1em;
		color: var(--color-primary);
	}
</style>
