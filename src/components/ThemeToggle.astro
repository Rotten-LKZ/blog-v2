---
---

<button class="theme-toggle-btn" aria-label="Toggle theme">
	<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="12" r="5" />
		<line x1="12" y1="1" x2="12" y2="3" />
		<line x1="12" y1="21" x2="12" y2="23" />
		<line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
		<line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
		<line x1="1" y1="12" x2="3" y2="12" />
		<line x1="21" y1="12" x2="23" y2="12" />
		<line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
		<line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
	</svg>
	<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
	</svg>
</button>

<script>
	document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const html = document.documentElement;
			const current = html.getAttribute('data-theme');
			const next = current === 'dark' ? 'light' : 'dark';
			html.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
		});
	});
</script>

<style>
	.theme-toggle-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: 2px solid var(--color-border);
		border-radius: 50%;
		background: var(--color-bg);
		color: var(--color-text-light);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.theme-toggle-btn:hover {
		color: var(--color-primary);
		border-color: var(--color-primary);
	}

	/* Light mode: show sun, hide moon */
	.icon-moon {
		display: none;
	}
	.icon-sun {
		display: block;
	}

	/* Dark mode: show moon, hide sun */
	[data-theme="dark"] .icon-sun {
		display: none;
	}
	[data-theme="dark"] .icon-moon {
		display: block;
	}
</style>
