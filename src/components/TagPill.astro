---
interface Props {
	tag: string;
}
const { tag } = Astro.props;
---

<span class="tag-pill">{tag}</span>

<style>
	.tag-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 10px;
		height: 24px;
		background: var(--color-primary-pale);
		color: var(--color-primary);
		border-radius: 999px;
		font-size: 0.75em;
		font-weight: 700;
		line-height: 1;
		white-space: nowrap;
		vertical-align: middle;
	}
</style>
