---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	showSidebar?: boolean;
}

const { title, description, image, showSidebar = true } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<MobileNav />
		<div class:list={['layout-wrapper', { 'no-sidebar': !showSidebar }]}>
			{showSidebar && <Sidebar />}
			<div class="content-area">
				<main>
					<slot />
				</main>
				<Footer />
			</div>
		</div>
		<script>
			const loadImages = () => {
				for (const img of document.querySelectorAll<HTMLImageElement>('img[data-image-src]')) {
					const url = img.dataset.imageSrc!;
					delete img.dataset.imageSrc;
					const infoUrl = new URL(url, location.href);
					if (infoUrl.pathname.startsWith('/i/')) {
						infoUrl.pathname = `/info/${infoUrl.pathname.slice(3)}`;
						fetch(infoUrl).then((response) => {
							if (!response.ok) throw new Error(`Image info: ${response.status}`);
							return response.json();
						}).then(({ data }) => {
							const width = Number(data?.width);
							const height = Number(data?.height);
							if (width > 0 && height > 0 && Number.isFinite(width) && Number.isFinite(height)) {
								img.width = width;
								img.height = height;
								const wrapper = img.closest<HTMLElement>('.photo-wrapper');
								if (wrapper) wrapper.style.aspectRatio = `${width} / ${height}`;
							}
						}).catch(() => {}).finally(() => { img.src = url; });
					} else {
						img.src = url;
					}
				}
			};
			loadImages();
			document.addEventListener('astro:page-load', loadImages);
		</script>

		<style>
			.layout-wrapper {
				display: flex;
				min-height: 100vh;
				max-width: 1800px;
				margin: 0 auto;
				padding: 0 2rem;
				gap: 2rem;
			}

			.content-area {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				padding-top: 2rem;
			}

			main {
				flex: 1;
				width: 100%;
				background: var(--color-bg-card);
				border-radius: var(--radius-lg);
				padding: 2.5rem;
				box-shadow: var(--shadow-soft);
				border: 1px solid var(--color-border);
				margin-bottom: 2rem;
			}

			.no-sidebar {
				max-width: 1000px;
			}

			.no-sidebar main {
				max-width: 100%;
			}

			@media (max-width: 1024px) {
				.layout-wrapper {
					padding: 0 1rem;
					gap: 1.5rem;
				}
				
				main {
					padding: 1.5rem;
				}
			}

			@media (max-width: 768px) {
				.layout-wrapper {
					flex-direction: column;
					padding: 0;
					gap: 0;
				}

				.content-area {
					padding-top: 60px; /* Offset for fixed mobile nav */
				}

				main {
					border-radius: 0;
					border-left: none;
					border-right: none;
					padding: 1.5rem 1rem;
					margin-bottom: 0;
					box-shadow: none;
				}
			}
		</style>
	</body>
</html>
